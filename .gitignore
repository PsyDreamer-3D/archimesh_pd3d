# Generic files to ignore.
.*
# CI workflows live under .github/, which the rule above would hide.
!.github/

# Python temp paths.
__pycache__/
*.py[cod]

# Editors.
*~
*.swp
*.swo
*#

# Local patches.
/*.patch
/*.diff

# Locally built extensions (scripts/build_dev.sh writes to dist/).
*.zip
/dist/
